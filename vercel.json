{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/lead.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-of-use", "destination": "/terms-of-use.html" },
    { "source": "/disclosures/marketing-partners", "destination": "/disclosures/marketing-partners.html" }
  ],
  "redirects": [
    { "source": "/privacy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/Terms.html", "destination": "/terms-of-use", "permanent": true },
    { "source": "/Terms", "destination": "/terms-of-use", "permanent": true },
    { "source": "/terms-of-service", "destination": "/terms-of-use", "permanent": true },
    { "source": "/terms-of-use.html", "destination": "/terms-of-use", "permanent": true },
    { "source": "/disclosures/marketing-partners.html", "destination": "/disclosures/marketing-partners", "permanent": true },
    { "source": "/affiliate-disclosure", "destination": "/Disclosure.html", "permanent": true },
    { "source": "/Disclosure", "destination": "/Disclosure.html", "permanent": true },
    { "source": "/our-partner-offers", "destination": "/Partner.html", "permanent": true },
    { "source": "/Partner", "destination": "/Partner.html", "permanent": true },
    { "source": "/thank-you", "destination": "/Thank.html", "permanent": true },
    { "source": "/Thank", "destination": "/Thank.html", "permanent": true },
    { "source": "/home-992457", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
