# Required: TrustedForm v4 Certificate API (HTTP Basic username is always API).
TRUSTEDFORM_API_KEY=

# Required: Standard Information endpoint and page-specific bearer credentials.
SI_POST_URL=https://exchange.standardinformation.io/post_test
SI_API_KEY=
SI_PARTNER_API_KEY=

# Required: GoHighLevel inbound webhook used for contact upsert.
GHL_WEBHOOK_URL=

# Optional: Upstash Redis / Vercel KV. Missing values intentionally fail open.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional behavior controls.
DEDUP_LOOKBACK_DAYS=30
SI_TIMEOUT_MS=12000
TRUSTEDFORM_TIMEOUT_MS=12000
GHL_TIMEOUT_MS=12000
LEAD_ALLOWED_ORIGINS=
ZIP_ALLOWLIST_PATH=
